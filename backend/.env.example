# ================================
# SERVER
# ================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# ================================
# SUPABASE
# ================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ================================
# GOOGLE GEMINI
# ================================
# Always read server-side. Never expose this key to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here

# gemini-2.5-flash is no longer served to new API projects.
# If a configured model is retired, the backend automatically switches to an
# available model for your key and logs a warning.
GEMINI_MODEL=gemini-3.8-flash

# Model Configuration
GEMINI_MODEL_TUTOR=gemini-3.8-flash
GEMINI_MODEL_UTILITY=gemini-3.8-flash
GEMINI_MODEL_PLANNER=gemini-3.8-flash

# Thinking budget (Gemini 3 reasons before answering, which adds latency).
# 0 disables thinking for fast structured/utility calls.
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_BUDGET_TUTOR=0
# Per-request timeout in milliseconds
GEMINI_TIMEOUT_MS=120000

# ================================
# WEAVIATE (Cloud or Local)
# ================================
WEAVIATE_URL=your-cluster.weaviate.cloud
# Scheme is auto-detected: https for .weaviate.cloud, http for local
# Uncomment to override: WEAVIATE_SCHEME=https
WEAVIATE_API_KEY=your_weaviate_api_key_here
WEAVIATE_CLASS_NAME=NCERTChunks
# The backend uses the gRPC weaviate-client. Weaviate Cloud no longer serves GraphQL.
# Search mode: 'true' (default) uses BM25 keyword search, which needs no vectorizer.
# Set to 'false' only if the collection has vectors and you want hybrid search.
WEAVIATE_USE_BM25_ONLY=true
# Connection/query timeout in milliseconds
WEAVIATE_TIMEOUT_MS=15000
# Local Weaviate only: gRPC port (default 50051)
# WEAVIATE_GRPC_PORT=50051
# Hybrid search alpha (only used if BM25_ONLY=false): 0 = pure BM25, 1 = pure vector, 0.5 = balanced
WEAVIATE_HYBRID_ALPHA=0.5

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# LOGGING
# ================================
LOG_LEVEL=info
